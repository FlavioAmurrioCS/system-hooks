root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# shfmt reads these when no style flags are passed (equivalent to `shfmt -i 2 -ci`).
[*.sh]
indent_style = space
indent_size = 2
switch_case_indent = true

[*.{py,toml,yaml,yml,json}]
indent_style = space

[*.md]
trim_trailing_whitespace = false
